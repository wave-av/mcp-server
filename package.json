{
  "name": "@wave-av/mcp-server",
  "version": "0.2.0",
  "description": "WAVE MCP Server - Exposes WAVE streaming APIs as tools for AI agents",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sdk-server": {
      "types": "./dist/sdk-server.d.ts",
      "import": "./dist/sdk-server.js",
      "default": "./dist/sdk-server.js"
    }
  },
  "bin": {
    "wave-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "MCP-DEBUGGING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declarationMap false",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src/ --max-warnings 0",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wave",
    "mcp",
    "model-context-protocol",
    "ai",
    "streaming",
    "tools"
  ],
  "author": "WAVE Online, LLC <mcp@wave.online>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wave-av/mcp-server.git",
    "directory": "."
  },
  "homepage": "https://docs.wave.online/mcp",
  "bugs": {
    "url": "https://github.com/wave-av/mcp-server/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.167",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "tsup": "^8.0.0",
    "tsx": "4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
